# TeamCompass / @cadence/web — copy to apps/web/.env.local for local overrides.
# Never commit real secrets. On Vercel, prefer Marketplace → Upstash Redis
# (auto-injects UPSTASH_* into the linked project), then `vercel env pull`.

# Store backend: omit to auto-detect (redis when Upstash vars exist, else file).
# CADENCE_STORE=file
# CADENCE_STORE=redis

# Local JSON file store (default for `npm run dev` without Upstash).
# CADENCE_DATA_DIR=/absolute/path/to/data

# Upstash Redis (required on Vercel Hobby for durable rooms across Functions).
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
