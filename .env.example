# TeamCompass / @cadence/web
# Preferred production path: single Node/Docker process + local JSON file (no Redis).
# Copy to apps/web/.env.local for local overrides. Never commit secrets.

# Force file store (default locally and in the Docker image).
CADENCE_STORE=file

# Where rooms.json lives (Docker/Render/Fly use /data).
# CADENCE_DATA_DIR=/data

# --- Optional only if you insist on Vercel Functions ---
# Vercel has no durable local disk; Redis is required there.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
# CADENCE_STORE=redis
