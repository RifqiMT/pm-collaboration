# TeamCompass / @cadence/web
# Never commit real secrets.

# --- Preferred for LAN / Docker / Render / Fly (local JSON file) ---
CADENCE_STORE=file
# CADENCE_DATA_DIR=/data

# --- Vercel: use Supabase (recommended remote store) ---
# 1) Run docs/supabase-schema.sql in the Supabase SQL editor (required once)
# 2) Set these in Vercel → Project → Settings → Environment Variables
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer secret key on the server. Publishable works with the anon RLS policy.
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy JWT keys still accepted:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# CADENCE_STORE=supabase

# --- Optional: Upstash Redis instead of Supabase on Vercel ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CADENCE_STORE=redis
