# TeamCompass / @cadence/web
# Never commit real secrets.

# --- Preferred for LAN / Docker / Render / Fly (local JSON file) ---
CADENCE_STORE=file
# CADENCE_DATA_DIR=/data

# --- Vercel: use Supabase (recommended remote store) ---
# 1) Run docs/supabase-schema.sql in the Supabase SQL editor
# 2) Set these in Vercel → Project → Settings → Environment Variables
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer the service_role key on the server (Settings → API). Falls back to anon.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# CADENCE_STORE=supabase

# --- Optional: Upstash Redis instead of Supabase on Vercel ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CADENCE_STORE=redis
